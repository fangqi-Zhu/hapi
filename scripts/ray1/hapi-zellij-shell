#!/usr/bin/env bash
set -euo pipefail

# HAPI invokes $SHELL without arguments for the web terminal. Preserve normal
# bash behavior for tools that invoke the configured shell with -c or -lc.
if [ "$#" -gt 0 ]; then
    exec /bin/bash "$@"
fi

export PATH="/root/.local/bin:/root/bin:/root/.local/node/bin:/usr/local/bin:/usr/bin:/bin"
export SHELL="/bin/bash"
export TERM="${TERM:-xterm-256color}"
export COLORTERM="${COLORTERM:-truecolor}"

cd /workspace

# Start outside Zellij so attaching an existing session never creates a nested
# client that constrains the session to the browser terminal's dimensions.
exec /bin/bash -i
